{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/meetings",
      "schedule": "0 13 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/auth-otp",
      "dest": "/api/notify-launch"
    },
    {
      "src": "/api/equipment-tags",
      "dest": "/api/notify-launch?equipment=tags"
    },
    {
      "src": "/api/equipment-operator",
      "dest": "/api/notify-launch?equipment=operator"
    },
    {
      "src": "/api/cue/import-timeline",
      "dest": "/api/cue/chat"
    },
    {
      "src": "/landing.html",
      "status": 301,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/landing",
      "status": 301,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/index.html",
      "status": 301,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/",
      "status": 301,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/changelog",
      "dest": "/changelog.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/sign-in",
      "status": 301,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/app",
      "dest": "/index.html"
    },
    {
      "src": "/app/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/t/([^/]+)",
      "dest": "/api/notify-launch?equipment=tap&id=$1"
    },
    {
      "src": "/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json"
      },
      "dest": "/.well-known/apple-app-site-association"
    },
    {
      "src": "/.well-known/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
